{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackmarshal.dev/schemas/task-graph.schema.json",
  "title": "StackMarshal Task Graph",
  "type": "object",
  "required": ["schema_version", "tasks", "integrity_algorithm", "integrity_key_id", "integrity_hmac_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary", "mandatory", "acceptance", "status", "attempts", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "summary": {"type": "string"},
          "mandatory": {"type": "boolean"},
          "acceptance": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["pending", "in_progress", "done", "blocked"]},
          "attempts": {"type": "integer", "minimum": 0},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "amendments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["reason", "previous_summary", "previous_acceptance", "previous_status", "previous_evidence"],
              "properties": {
                "reason": {"type": "string", "minLength": 1},
                "previous_summary": {"type": "string"},
                "previous_acceptance": {"type": "array", "items": {"type": "string"}},
                "previous_status": {"enum": ["pending", "in_progress", "done", "blocked"]},
                "previous_evidence": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "integrity_algorithm": {"const": "hmac-sha256-v1"},
    "integrity_key_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "integrity_hmac_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackmarshal.dev/schemas/run-state.schema.json",
  "title": "StackMarshal Run State",
  "type": "object",
  "required": ["schema_version", "run_id", "project", "invocation", "mode", "phase", "status", "budget", "progress", "integrity_algorithm", "integrity_key_id", "integrity_hmac_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^\\d{8}-\\d{6}-[a-f0-9]{8}$"},
    "project": {
      "type": "object",
      "required": ["root", "dirty"],
      "properties": {
        "root": {"type": "string"},
        "git_head": {"type": ["string", "null"]},
        "identity_hash": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"},
        "git_toplevel": {"type": ["string", "null"]},
        "repository_owned": {"type": "boolean"},
        "repository_lineage": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "invocation": {
      "type": "object",
      "required": ["explicit", "raw_text", "language"],
      "properties": {
        "explicit": {"const": true},
        "raw_text": {"type": "string"},
        "language": {"type": "string"}
      },
      "additionalProperties": false
    },
    "mode": {"enum": ["research", "prepare", "build", "resume"]},
    "phase": {"enum": ["INVOCATION_CHECK", "INTENT_NORMALIZATION", "ENVIRONMENT_AUDIT", "RESEARCH_GATE", "LANDSCAPE_RESEARCH", "CAPABILITY_MAPPING", "CAPABILITY_DISCOVERY", "TRUST_EVALUATION", "ISOLATED_POC", "ARCHITECTURE_FREEZE", "TASK_GRAPH", "IMPLEMENTATION", "VERIFICATION", "CORRECTION", "REPLAN", "CHECKPOINTING", "COMPLETE", "STOPPED"]},
    "status": {"enum": ["RUNNING", "COMPLETE", "CHECKPOINT_READY", "BUDGET_EXHAUSTED", "STAGNATED", "REPEATED_FAILURE", "APPROVAL_REQUIRED", "BLOCKED_EXTERNAL", "VERIFICATION_EXTERNAL_BLOCKED", "UNSAFE_DEPENDENCY", "SCOPE_DRIFT", "INVALID_STATE", "USER_CANCELLED"]},
    "budget": {
      "type": "object",
      "required": ["profile", "limits", "used"],
      "properties": {
        "profile": {"enum": ["quick", "standard", "deep"]},
        "limits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "used": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "progress": {"type": "object"},
    "stop_reason": {"type": ["object", "null"]},
    "completed_phases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "integrity_algorithm": {"const": "hmac-sha256-v1"},
    "integrity_key_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "integrity_hmac_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
